PORT=4000
JWT_SECRET=change-me-in-production
FRONTEND_URL=http://localhost:5173

DATABASE_URL="file:./dev.db"

# Optional — leave unset to run without payments. POST /api/orders/:id/checkout
# returns a 501 with an explanatory message until STRIPE_SECRET_KEY is set.
# Get test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:4000/api/stripe/webhook`, or
# your webhook endpoint's signing secret in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
